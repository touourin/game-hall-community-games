{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-hall.local/schemas/spoiled-fruit-card-catalog-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameKey", "deckRule", "cards"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "gameKey": { "const": "spoiled-fruit" },
    "deckRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalCardCount", "normalPairCount", "oldMaidFormula", "playerCounts", "totalCardsByPlayerCount"],
      "properties": {
        "normalCardCount": { "const": 60 },
        "normalPairCount": { "const": 30 },
        "oldMaidFormula": { "const": "floor(playerCount / 2)" },
        "playerCounts": { "const": [4, 5, 6, 7, 8] },
        "totalCardsByPlayerCount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["4", "5", "6", "7", "8"],
          "properties": {
            "4": { "const": 62 },
            "5": { "const": 62 },
            "6": { "const": 63 },
            "7": { "const": 63 },
            "8": { "const": 64 }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cardCode", "sortIndex", "kind", "nameZh", "nameEn", "slug", "copies", "pairKey", "effectId", "asset", "includeAtPlayerCounts"],
        "properties": {
          "id": { "type": "string", "pattern": "^(fruit-[0-9]{2}|old-maid-[0-9]{2})$" },
          "cardCode": { "type": "string", "pattern": "^([0-9]{2}|B[0-9]{2})$" },
          "sortIndex": { "type": "integer", "minimum": 1, "maximum": 104 },
          "kind": { "enum": ["normal", "old_maid"] },
          "nameZh": { "type": "string", "minLength": 1 },
          "nameEn": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "copies": { "type": "integer", "minimum": 1, "maximum": 2 },
          "pairKey": { "type": ["string", "null"] },
          "effectId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "asset": { "type": "string", "pattern": "^\\.\\./assets/cards/.+\\.png$" },
          "includeAtPlayerCounts": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 4, "maximum": 8 }
          }
        }
      }
    }
  }
}
