{
  "schemaVersion": 1,
  "authority": "server",
  "initial": "setup",
  "states": {
    "setup": {
      "on": { "start": "select" },
      "invariants": ["104 张牌洗混", "每名玩家 10 张", "四行各 1 张"]
    },
    "select": {
      "on": { "select_card": "select", "all_committed": "resolving" },
      "invariants": ["每名有效玩家至多锁定一张", "未全员提交前不公开牌号"]
    },
    "resolving": {
      "on": {
        "place": "resolving",
        "full_row": "resolving",
        "forced_row": "resolving",
        "turn_complete": "select",
        "hand_complete": "round_summary",
        "threshold_reached": "finished"
      },
      "invariants": ["按牌号严格升序", "四行按行首升序", "按行首区间唯一判行", "无法追加时自动收行并以出牌重开"]
    },
    "round_summary": {
      "on": { "next_round": "select" },
      "invariants": ["收牌不回手", "本轮牛头分已累计"]
    },
    "finished": {
      "on": {},
      "invariants": ["除宿主再来一局外拒绝规则动作"]
    }
  },
  "actions": {
    "select_card": { "payload": ["cardId", "turnNumber"], "private": true },
    "next_round": { "payload": ["roundNumber"], "private": false },
    "resign": { "payload": [], "private": false }
  }
}
