{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-hall.local/schemas/love-letter/game-state.schema.json",
  "title": "Love Letter authoritative game state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelVersion",
    "gameId",
    "profileId",
    "status",
    "revision",
    "roundNumber",
    "turnNumber",
    "eventSeq",
    "rngCommitment",
    "cardRegistry",
    "players",
    "round",
    "gameWinnerIds",
    "lastEvent"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "modelVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gameId": { "const": "love-letter" },
    "profileId": { "enum": ["queen_22", "current_21", "classic_16"] },
    "status": { "enum": ["setup", "active", "finished"] },
    "revision": { "type": "integer", "minimum": 0 },
    "roundNumber": { "type": "integer", "minimum": 1 },
    "turnNumber": { "type": "integer", "minimum": 0 },
    "eventSeq": { "type": "integer", "minimum": 0 },
    "rngCommitment": { "type": "string", "minLength": 8 },
    "cardRegistry": {
      "type": "array",
      "minItems": 16,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/cardInstance" }
    },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/player" }
    },
    "round": { "$ref": "#/$defs/round" },
    "gameWinnerIds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/playerId" }
    },
    "lastEvent": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/publicEvent" }
      ]
    }
  },
  "$defs": {
    "playerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "instanceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-[0-9]{2}$" },
    "cardInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "cardTypeId"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/instanceId" },
        "cardTypeId": { "$ref": "#/$defs/slug" }
      }
    },
    "playedCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardInstanceId", "cardTypeId", "turnNumber", "reason"],
      "properties": {
        "cardInstanceId": { "$ref": "#/$defs/instanceId" },
        "cardTypeId": { "$ref": "#/$defs/slug" },
        "turnNumber": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["played", "prince", "guard-hit", "eliminated", "round-reveal"] }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "seat", "name", "favorTokens", "roundStatus", "protected", "hand", "played"],
      "properties": {
        "id": { "$ref": "#/$defs/playerId" },
        "seat": { "type": "integer", "minimum": 0, "maximum": 3 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "favorTokens": { "type": "integer", "minimum": 0, "maximum": 20 },
        "roundStatus": { "enum": ["active", "out"] },
        "protected": { "type": "boolean" },
        "hand": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instanceId" }
        },
        "played": {
          "type": "array",
          "maxItems": 22,
          "items": { "$ref": "#/$defs/playedCard" }
        }
      }
    },
    "pendingChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choiceId",
        "kind",
        "actorPlayerId",
        "sourceCardInstanceId",
        "createdRevision",
        "candidatePlayerIds",
        "candidateCardTypeIds",
        "privateCardIds"
      ],
      "properties": {
        "choiceId": { "type": "string", "pattern": "^choice-[A-Za-z0-9_-]+$" },
        "kind": { "enum": ["player", "player-and-card-type", "keep-and-order"] },
        "actorPlayerId": { "$ref": "#/$defs/playerId" },
        "sourceCardInstanceId": { "$ref": "#/$defs/instanceId" },
        "createdRevision": { "type": "integer", "minimum": 0 },
        "candidatePlayerIds": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/playerId" }
        },
        "candidateCardTypeIds": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "privateCardIds": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instanceId" }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viewerPlayerIds", "subjectPlayerId", "cardInstanceId", "source", "acquiredRevision", "current"],
      "properties": {
        "id": { "type": "string", "pattern": "^knowledge-[A-Za-z0-9_-]+$" },
        "viewerPlayerIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/playerId" }
        },
        "subjectPlayerId": { "$ref": "#/$defs/playerId" },
        "cardInstanceId": { "$ref": "#/$defs/instanceId" },
        "source": { "enum": ["priest", "baron", "king-swap", "own-hand"] },
        "acquiredRevision": { "type": "integer", "minimum": 0 },
        "current": { "type": "boolean" }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startPlayerId",
        "currentPlayerId",
        "phase",
        "deck",
        "reserveCardId",
        "faceUpSetAside",
        "pendingChoice",
        "privateKnowledge",
        "roundWinnerIds",
        "rewardDeltas",
        "endReason"
      ],
      "properties": {
        "startPlayerId": { "$ref": "#/$defs/playerId" },
        "currentPlayerId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/playerId" }
          ]
        },
        "phase": {
          "enum": [
            "round_setup",
            "turn_draw",
            "turn_play",
            "effect_choice",
            "chancellor_choice",
            "effect_resolution",
            "round_end",
            "between_rounds",
            "finished"
          ]
        },
        "deck": {
          "type": "array",
          "maxItems": 22,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instanceId" }
        },
        "reserveCardId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/instanceId" }
          ]
        },
        "faceUpSetAside": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/instanceId" }
        },
        "pendingChoice": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/pendingChoice" }
          ]
        },
        "privateKnowledge": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/knowledge" }
        },
        "roundWinnerIds": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/playerId" }
        },
        "rewardDeltas": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 }
        },
        "endReason": {
          "enum": [null, "last-player", "one-card-left", "forfeit"]
        }
      }
    },
    "publicEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventSeq", "kind", "actorPlayerId", "targetPlayerIds", "publicMessageZh"],
      "properties": {
        "eventSeq": { "type": "integer", "minimum": 0 },
        "kind": { "$ref": "#/$defs/slug" },
        "actorPlayerId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/playerId" }
          ]
        },
        "targetPlayerIds": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/playerId" }
        },
        "publicMessageZh": { "type": "string", "minLength": 1 }
      }
    }
  }
}
