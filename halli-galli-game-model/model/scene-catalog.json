    { "id": "seat_0", "role": "相对座位 0（本人）", "rect": { "x": 0.37, "y": 0.66, "width": 0.26, "height": 0.24 }, "zIndex": 30, "visibility": "player-count-dependent", "interaction": "read-only" },
    { "id": "seat_1", "role": "相对座位 1", "rect": { "x": 0.05, "y": 0.58, "width": 0.22, "height": 0.25 }, "zIndex": 30, "visibility": "player-count-dependent", "interaction": "read-only" },
    { "id": "seat_2", "role": "相对座位 2", "rect": { "x": 0.05, "y": 0.17, "width": 0.22, "height": 0.25 }, "zIndex": 30, "visibility": "player-count-dependent", "interaction": "read-only" },
    { "id": "seat_3", "role": "相对座位 3（上方）", "rect": { "x": 0.37, "y": 0.08, "width": 0.26, "height": 0.22 }, "zIndex": 30, "visibility": "player-count-dependent", "interaction": "read-only" },
    { "id": "seat_4", "role": "相对座位 4", "rect": { "x": 0.73, "y": 0.17, "width": 0.22, "height": 0.25 }, "zIndex": 30, "visibility": "player-count-dependent", "interaction": "read-only" },
    { "id": "seat_5", "role": "相对座位 5", "rect": { "x": 0.73, "y": 0.58, "width": 0.22, "height": 0.25 }, "zIndex": 30, "visibility": "player-count-dependent", "interaction": "read-only" },
