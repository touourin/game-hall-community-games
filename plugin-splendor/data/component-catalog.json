  "digitalRulings": [
    {
      "id": "short-supply-take-maximum-distinct",
      "summaryZh": "只有不足 3 种非空宝石色时才可少取；此时从每个非空颜色各取 1 枚，即取 min(3, 非空颜色数) 枚。"
    },
    {
      "id": "face-up-reservation-remains-public-knowledge",
      "summaryZh": "从市场保留的牌继续向所有视角显示身份；盲抽保留牌只向持有者显示身份，其他视角只显示等级。"
    },
    {
      "id": "player-selects-exact-payment",
      "summaryZh": "购买时玩家提交精确支付向量；在不超付的前提下可主动以黄金替代仍持有的对应颜色宝石。"
    },
    {
      "id": "platform-first-player-controls-marker",
      "summaryZh": "实体规则由最年轻玩家持首位标记；线上房间由宿主先手配置决定，并把标记绑定到实际首家。"
    }
  ],
  "copyrightBoundary": "Numerical rules and original neutral prototypes only; do not copy official logos, card art, noble portraits, ornamental frames, or scans."
