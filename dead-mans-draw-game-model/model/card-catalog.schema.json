{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-hall.local/schemas/dead-mans-draw/card-catalog.schema.json",
  "title": "Dead Man's Draw card catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelVersion", "gameId", "componentSummary", "sourceBasis", "suits", "traits", "variants", "mermaidVariant"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "modelVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gameId": { "const": "dead-mans-draw" },
    "componentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lootCards", "baseTraits", "suits", "cardsPerSuit"],
      "properties": {
        "lootCards": { "const": 60 },
        "baseTraits": { "const": 17 },
        "suits": { "const": 10 },
        "cardsPerSuit": { "const": 6 }
      }
    },
    "sourceBasis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    },
    "suits": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/suit" }
    },
    "traits": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/trait" }
    },
    "variants": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/variant" }
    },
    "mermaidVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removedLootCardIds", "addedLootCardIds", "abilityOverride", "addedTrait", "casanovaOverride"],
      "properties": {
        "removedLootCardIds": {
          "type": "array",
          "const": ["loot-mermaid-8", "loot-mermaid-9"]
        },
        "addedLootCardIds": {
          "type": "array",
          "const": ["loot-mermaid-2", "loot-mermaid-3"]
        },
        "abilityOverride": { "$ref": "#/$defs/ability" },
        "addedTrait": { "$ref": "#/$defs/trait" },
        "casanovaOverride": { "$ref": "#/$defs/modifier" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "localizedName": { "type": "string", "minLength": 1 },
    "ability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opcode", "timing", "choiceKind", "mandatory", "canForceBust", "summaryZh", "params"],
      "properties": {
        "opcode": { "$ref": "#/$defs/slug" },
        "timing": { "enum": ["on_enter", "on_collect", "passive_score"] },
        "choiceKind": { "enum": ["none", "own_bank_stack", "opponent_bank_stack", "discard_card", "play_entry"] },
        "mandatory": { "type": "boolean" },
        "canForceBust": { "type": "boolean" },
        "summaryZh": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    },
    "suit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameZh", "nameEn", "symbol", "icon", "color", "category", "values", "ability"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "nameZh": { "$ref": "#/$defs/localizedName" },
        "nameEn": { "$ref": "#/$defs/localizedName" },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 2 },
        "icon": { "$ref": "#/$defs/slug" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "category": { "enum": ["protection", "replay", "attack", "combo", "selection", "information", "forced", "scoring"] },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base", "mermaidVariant"],
          "properties": {
            "base": { "$ref": "#/$defs/valueSet" },
            "mermaidVariant": { "$ref": "#/$defs/valueSet" }
          }
        },
        "ability": { "$ref": "#/$defs/ability" }
      }
    },
    "valueSet": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 2, "maximum": 9 }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opcode", "params"],
      "properties": {
        "opcode": { "$ref": "#/$defs/slug" },
        "params": { "type": "object" }
      }
    },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameZh", "nameEn", "appliesTo", "scope", "timing", "mandatory", "summaryZh", "modifier"],
      "properties": {
        "id": { "type": "string", "pattern": "^trait-[a-z][a-z0-9-]*$" },
        "nameZh": { "$ref": "#/$defs/localizedName" },
        "nameEn": { "$ref": "#/$defs/localizedName" },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "scope": { "enum": ["self", "opponents", "chosen-opponent"] },
        "timing": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["setup", "before-entry", "candidate-generation", "ability-resolution", "protection-update", "on-collect", "after-bust", "score"] }
        },
        "mandatory": { "const": true },
        "summaryZh": { "type": "string", "minLength": 1 },
        "modifier": { "$ref": "#/$defs/modifier" },
        "mermaidVariantSummaryZh": { "type": "string", "minLength": 1 },
        "mermaidVariantModifier": { "$ref": "#/$defs/modifier" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameZh", "nameEn", "provenance", "axis", "summaryZh", "modifier", "requiresDigitalRuling"],
      "properties": {
        "id": { "type": "string", "pattern": "^variant-[a-z][a-z0-9-]*$" },
        "nameZh": { "$ref": "#/$defs/localizedName" },
        "nameEn": { "$ref": "#/$defs/localizedName" },
        "provenance": { "const": "official-web" },
        "axis": { "enum": ["bust-destination", "score-aggregation", "instant-win", "end-score", "bust-key", "score-eligibility", "bank-target-position"] },
        "summaryZh": { "type": "string", "minLength": 1 },
        "modifier": { "$ref": "#/$defs/modifier" },
        "requiresDigitalRuling": { "type": "boolean" }
      }
    }
  }
}
