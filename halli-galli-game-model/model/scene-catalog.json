  "seatStates": [
    { "id": "ready", "labelZh": "可翻牌／可抢铃", "tone": "neutral", "canFlip": true, "canRing": true },
    { "id": "current_turn", "labelZh": "轮到翻牌", "tone": "focus", "canFlip": true, "canRing": true },
    { "id": "last_chance", "labelZh": "无牌·仍可抢铃", "tone": "warning", "canFlip": false, "canRing": true },
    { "id": "eliminated", "labelZh": "已退出", "tone": "muted", "canFlip": false, "canRing": false },
    { "id": "ring_claimed", "labelZh": "先按到", "tone": "success", "canFlip": false, "canRing": false },
    { "id": "wrong_bell", "labelZh": "误按", "tone": "danger", "canFlip": false, "canRing": false },
    { "id": "disconnected", "labelZh": "重连中", "tone": "warning", "canFlip": false, "canRing": false }
  ],
  "scenes": [
    { "id": "waiting_room", "phase": "waiting", "requiredZones": ["table_stage", "turn_banner", "rules_drawer", "live_region"], "primaryActions": [], "focusTarget": "rules_drawer", "announcementZh": "等待玩家并确认终局规则" },
    { "id": "playing_self_turn", "phase": "playing", "requiredZones": ["table_stage", "bell_zone", "fruit_legend", "turn_banner", "self_controls", "event_strip", "rules_drawer", "live_region"], "primaryActions": ["flip_card", "ring_bell"], "focusTarget": "self_controls", "announcementZh": "轮到你翻牌，铃铛仍可随时使用" },
    { "id": "playing_other_turn", "phase": "playing", "requiredZones": ["table_stage", "bell_zone", "fruit_legend", "turn_banner", "event_strip", "rules_drawer", "live_region"], "primaryActions": ["ring_bell"], "focusTarget": "bell_zone", "announcementZh": "等待其他玩家翻牌，你仍可抢铃" },
    { "id": "exact_five_visible", "phase": "playing", "requiredZones": ["table_stage", "bell_zone", "turn_banner", "live_region"], "primaryActions": ["ring_bell"], "focusTarget": "bell_zone", "announcementZh": "牌面已更新" },
    { "id": "bell_resolved_correct", "phase": "presentation", "requiredZones": ["table_stage", "bell_zone", "reaction_banner", "live_region"], "primaryActions": [], "focusTarget": "reaction_banner", "announcementZh": "正确抢铃，明牌已归入赢家牌堆" },
    { "id": "bell_resolved_wrong", "phase": "presentation", "requiredZones": ["table_stage", "bell_zone", "reaction_banner", "live_region"], "primaryActions": [], "focusTarget": "reaction_banner", "announcementZh": "误按铃，已执行对应处罚" },
    { "id": "last_chance_player", "phase": "playing", "requiredZones": ["table_stage", "bell_zone", "turn_banner", "live_region"], "primaryActions": ["ring_bell"], "focusTarget": "bell_zone", "announcementZh": "你的抽牌已空，但明牌尚在，仍可抢铃" },
    { "id": "finished", "phase": "finished", "requiredZones": ["table_stage", "result_overlay", "live_region"], "primaryActions": ["restart"], "focusTarget": "result_overlay", "announcementZh": "游戏结束，结果已结算" }
  ],
  "animationCues": [
    { "id": "card_flip", "durationMs": 180, "fromZone": null, "toZone": "seat_0", "reducedMotion": "fade", "blocksBell": false, "ariaTemplateZh": "{player} 翻开 {card}" },
    { "id": "bell_press_local", "durationMs": 70, "fromZone": "bell_zone", "toZone": "bell_zone", "reducedMotion": "outline", "blocksBell": false, "ariaTemplateZh": "抢铃请求已发送" },
    { "id": "bell_confirmed", "durationMs": 160, "fromZone": "bell_zone", "toZone": "reaction_banner", "reducedMotion": "outline", "blocksBell": true, "ariaTemplateZh": "{player} 先按到铃" },
    { "id": "collect_piles", "durationMs": 220, "fromZone": "table_stage", "toZone": "seat_0", "reducedMotion": "instant", "blocksBell": true, "ariaTemplateZh": "{player} 收走 {count} 张明牌" },
    { "id": "penalty_transfer", "durationMs": 180, "fromZone": "seat_0", "toZone": "table_stage", "reducedMotion": "instant", "blocksBell": true, "ariaTemplateZh": "{player} 因误按付出 {count} 张牌" },
    { "id": "player_eliminated", "durationMs": 200, "fromZone": null, "toZone": "table_stage", "reducedMotion": "outline", "blocksBell": false, "ariaTemplateZh": "{player} 已退出本局" },
    { "id": "final_duel_armed", "durationMs": 260, "fromZone": null, "toZone": "turn_banner", "reducedMotion": "outline", "blocksBell": false, "ariaTemplateZh": "进入最终二人阶段，下一次铃结束游戏" },
    { "id": "result_enter", "durationMs": 240, "fromZone": null, "toZone": "result_overlay", "reducedMotion": "fade", "blocksBell": true, "ariaTemplateZh": "游戏结束，{winner} 获胜" }
  ],
  "responsiveStrategy": {
    "wide": "六个席位沿桌面椭圆分布，本人固定下方；顶牌正立，中央铃直径 136。",
    "medium": "缩短席位身份栏并压缩抽牌堆深度，仍保持所有顶牌同时可见。",
    "compact": "对手顶牌使用最多五列矩阵，本人在铃下方；中央铃直径 88，事件条折叠为一行。",
    "narrow": "隐藏对手长名称而保留座位号、顶牌数字和资格；不使用轮播或页面横向滚动。"
  },
  "fidelity": {
    "allTopCardsSimultaneouslyVisible": true,
    "showAggregateFruitTotalsDefault": false,
    "highlightCorrectBellConditionDefault": false,
    "coveredCardsBrowsableDuringPlay": false,
    "bellAvailableDuringFlipAnimation": true
  },
  "accessibility": {
    "notColorOnly": true,
    "liveRegion": "polite for flips; assertive only for the viewer's resolved bell",
    "reducedMotion": "replace rotation, flight and pulse with fade, outline and numeric updates",
    "keyboardActions": ["Space: ring bell", "Enter: activate focused primary action", "F: flip when eligible", "R: open rules when not typing", "Escape: close local overlay"],
    "minimumTextContrast": 4.5,
    "minimumLargeSymbolContrast": 3.0,
    "minimumBellTarget": 64
  }
}
