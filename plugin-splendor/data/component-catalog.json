    { "id": "black", "nameZh": "缟玛瑙", "symbol": "●", "semanticColor": "#353A3D", "pattern": "crosshatch" },
    { "id": "gold", "nameZh": "黄金百搭", "symbol": "★", "semanticColor": "#C79B43", "pattern": "sunburst" }
