{
  "schemaVersion": 3,
  "logicalCanvas": { "width": 1, "height": 1 },
  "camera": {
    "projection": "perspective-chase",
    "fieldOfViewDegrees": 52,
    "desktopVanishingPoint": [0.5, 0.31],
    "mobileVanishingPoint": [0.5, 0.28]
  },
  "anchors": {
    "desktop": {
      "runner": [0.5, 0.88],
      "leftLane": [0.18, 0.35],
      "centerLane": [0.5, 0.31],
      "rightLane": [0.82, 0.35],
      "obstacle": [0.5, 0.58]
    },
    "mobile": {
      "runner": [0.5, 0.86],
      "leftLane": [0.17, 0.34],
      "centerLane": [0.5, 0.3],
      "rightLane": [0.83, 0.34],
      "obstacle": [0.5, 0.56]
    }
  },
  "lanes": [
    { "id": "left", "action": "left", "key": "a", "symbol": "←" },
    { "id": "center", "actions": ["jump", "slide"], "keys": ["w", "s"] },
    { "id": "right", "action": "right", "key": "d", "symbol": "→" }
  ],
  "obstacles": [
    { "id": "ground", "action": "jump", "key": "w", "clearance": "above" },
    { "id": "overhead", "action": "slide", "key": "s", "clearance": "below" }
  ],
  "modules": {
    "bridge": [1.0, 0.68],
    "lane": [0.31, 0.66],
    "gate": [0.27, 0.13],
    "groundObstacle": [0.13, 0.1],
    "overheadObstacle": [0.13, 0.16]
  },
  "runtime": {
    "renderer": "dom-css",
    "backgroundAsset": "frontend/assets/runner-bridge-backdrop.png",
    "runnerAsset": "frontend/assets/runner-motion-atlas.png",
    "runnerAtlas": {
      "columns": 3,
      "rows": 2,
      "cellSize": [512, 512],
      "poses": ["run-a", "run-b", "right", "left", "jump", "slide"]
    },
    "motionLayers": [
      "backdrop-drift",
      "bridge-grid",
      "sleeper-approach",
      "rail-marker-approach",
      "question-section-approach",
      "speed-lines"
    ],
    "branchCounts": [2, 3],
    "maxSpeedLines": 12,
    "reducedMotion": "static-pose-and-fade",
    "keepsHostHeaderVisible": true
  }
}
