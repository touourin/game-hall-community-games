  },
  "informationPolicy": {
    "public": [
      "piece supply and every player's held-piece counts",
      "face-up market cards, purchased cards, bonuses, scores, and acquired nobles",
      "development deck counts and every reserved card's level",
      "identity of a market card that was reserved face up"
    ],
    "ownerOnly": ["identity of a card reserved blindly from a deck"],
    "serverOnly": ["development deck order", "unused noble order", "RNG seed"]
