    { "id": "fruit_legend", "role": "四种水果图例；忠实模式不显示聚合答案", "rect": { "x": 0.35, "y": 0.29, "width": 0.30, "height": 0.07 }, "zIndex": 55, "visibility": "playing", "interaction": "read-only" },
