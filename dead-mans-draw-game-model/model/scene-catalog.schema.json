{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-hall.local/schemas/dead-mans-draw/scene-catalog.schema.json",
  "title": "Dead Man's Draw scene catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelVersion", "gameId", "logicalCanvas", "theme", "cardMetrics", "breakpoints", "zones", "seatLayouts", "scenes", "animationCues", "responsiveStrategy", "accessibility"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "modelVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gameId": { "const": "dead-mans-draw" },
    "logicalCanvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": { "const": 1600 },
        "height": { "const": 900 },
        "unit": { "const": "logical-pixel" }
      }
    },
    "theme": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "cardMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "cornerRadius", "compactWidth", "minimumTarget"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "cornerRadius": { "type": "integer", "minimum": 0 },
        "compactWidth": { "type": "integer", "minimum": 1 },
        "minimumTarget": { "type": "integer", "minimum": 44 }
      }
    },
    "breakpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compactMax", "mediumMax", "wideMin"],
      "properties": {
        "compactMax": { "const": 759 },
        "mediumMax": { "const": 1179 },
        "wideMin": { "const": 1180 }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/zone" }
    },
    "seatLayouts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/seatLayout" }
    },
    "scenes": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/scene" }
    },
    "animationCues": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/cue" }
    },
    "responsiveStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wide", "medium", "compact", "narrow"],
      "properties": {
        "wide": { "type": "string", "minLength": 1 },
        "medium": { "type": "string", "minLength": 1 },
        "compact": { "type": "string", "minLength": 1 },
        "narrow": { "type": "string", "minLength": 1 }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notColorOnly", "liveRegion", "reducedMotion", "keyboardActions", "minimumContrast"],
      "properties": {
        "notColorOnly": { "const": true },
        "liveRegion": { "type": "string", "minLength": 1 },
        "reducedMotion": { "type": "string", "minLength": 1 },
        "keyboardActions": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
        "minimumContrast": { "type": "number", "minimum": 4.5 }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "rect", "zIndex", "visibility", "interaction"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "role": { "type": "string", "minLength": 1 },
        "rect": { "$ref": "#/$defs/rect" },
        "zIndex": { "type": "integer", "minimum": 0 },
        "visibility": { "enum": ["always", "player-count-dependent", "phase-dependent"] },
        "interaction": { "enum": ["read-only", "primary-action", "effect-target", "modal", "expandable"] }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativeSeat", "zoneId", "rotation"],
      "properties": {
        "relativeSeat": { "type": "integer", "minimum": 0, "maximum": 3 },
        "zoneId": { "type": "string" },
        "rotation": { "type": "integer", "minimum": 0, "maximum": 359 }
      }
    },
    "seatLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerCount", "seats"],
      "properties": {
        "playerCount": { "type": "integer", "minimum": 2, "maximum": 4 },
        "seats": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/seat" } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "requiredZones", "primaryActions", "focusTarget", "announcementZh"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "phase": { "enum": ["trait_selection", "turn", "effect_choice", "finished", "presentation"] },
        "requiredZones": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "primaryActions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "focusTarget": { "type": "string" },
        "announcementZh": { "type": "string", "minLength": 1 }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durationMs", "fromZone", "toZone", "reducedMotion", "ariaTemplateZh"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 1200 },
        "fromZone": { "type": ["string", "null"] },
        "toZone": { "type": ["string", "null"] },
        "reducedMotion": { "enum": ["fade", "instant", "outline"] },
        "ariaTemplateZh": { "type": "string", "minLength": 1 }
      }
    }
  }
}
