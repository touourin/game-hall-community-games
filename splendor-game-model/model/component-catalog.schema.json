{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-hall.local/schemas/splendor/component-catalog.schema.json",
  "title": "Splendor component and rule constants",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "modelVersion", "gameId", "rulesBaseline", "colors", "components", "informationPolicy", "digitalRulings", "copyrightBoundary"],
  "properties": {
    "$schema": { "const": "./component-catalog.schema.json" },
    "schemaVersion": { "const": 1 },
    "modelVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "gameId": { "const": "splendor" },
    "rulesBaseline": { "type": "object" },
    "colors": { "type": "array", "minItems": 6, "maxItems": 6 },
    "components": { "type": "object" },
    "informationPolicy": { "type": "object" },
    "digitalRulings": { "type": "array", "minItems": 4 },
    "copyrightBoundary": { "type": "string", "minLength": 20 }
  }
}
